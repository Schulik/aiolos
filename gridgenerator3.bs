#!/bin/bash
#based on https://unix.stackexchange.com/questions/204069/all-possible-combinations-of-characters-and-numbers

nl=$'\n'; tab=$'\t'
n=${1:-3}
eval set -- "$2"

eval "varnames=($(echo {a..z}))"

for i; 
do
        echo $i
done

#Edit the following line so that the looping variable is only one variable entry and not the entire permutation space every time!
#for i in "${varnames[@]:0:$n}"; do

IFS=':' read -ra TMP <<< $1
for i in "${TMP[@]}"; 
do
        echo "paramvalues in second loop $i"
done



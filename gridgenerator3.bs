###############################################
################Modified loop
###############################################
#VARAR=("me" "2H1" "kzz" "ocool" "FUV")
VARAR=("me" "2H1")
for i in "${!VARAR[@]}"; do
        #    header+='for '"$i"' do '
        echo "in code gen: "

        #IFS=':' read -ra TMP3 <<< $1
        echo "TMP = " "${TMP[i]}"
        echo "VARAR = " "${VARAR[i]}"

        #echo "in code gen: TMP[$i] = $TMP[$i]"
        #echo "in code gen: ${TMP[$i]}${nl}"
        header+='for '"${varnames[$i]}"' in'
	
	IFS=',' read -ra TMP3 <<< "${TMP[i]}"
	if(( ${#TMP3[@]} != 0 )); then     #Check that argument list for that variable is non-empty
		for j in "${TMP3[@]}"; 
		do
			header+=" $j"
		done
	fi
	header+='; do '
        middle+='$'"${varnames[$i]}"
        tail+="done; "
done
#middle+="\n"

CMD0="    cp blafile.dat blafile\$TMP4.dat${nl}"
CMD1="    sed -i 's/VAR1.*/VAR1              '\$a' /' blafile\$TMP4.dat${nl}"
CMD2="    sed -i 's/VAR2.*/VAR2              '\$b' /' blafile\$TMP4.dat${nl}"
CMD3="    sed -i 's/VAR3.*/VAR3              '\$b' /' blafile\$TMP4.dat${nl}"
CMD4="    sed -i 's/VAR4.*/VAR4              '\$b' /' blafile\$TMP4.dat${nl}"
CMD5="    sed -i 's/VAR5.*/VAR5              '\$b' /' blafile\$TMP4.dat${nl}"

TMP4=""
TMP5=""
loop="${header}${nl}    TMP4=\"$middle\";${nl}    echo \$TMP4${nl}    TMP5+=\"$middle\"\" \";${nl}${CMD0}${CMD1}${CMD2}${CMD3}${CMD4}${CMD5} $tail"
#loop="${header}${nl}    printf %s' ' \"$middle\";${nl} echo \$TMP4 ${nl}$tail"
echo "$loop"
eval "$loop"

